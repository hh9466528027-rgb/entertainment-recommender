# Copy this file to .env and fill in your own credentials.
# Never commit real API keys; .env is ignored by Git.

# Movies & series — https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Anime — AniList and Jikan need no API key.

# Games — https://rawg.io/apidocs
RAWG_API_KEY=

# Novels — optional for higher Google Books quotas; Gutenberg/Open Library need no key.
GOOGLE_BOOKS_API_KEY=

# Comics — https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=

# Music — optional Spotify compatibility/fallback credentials.
# Deezer and Apple/iTunes searches do not need credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional Apple/iTunes storefront country (defaults to IN).
# ITUNES_COUNTRY=IN
