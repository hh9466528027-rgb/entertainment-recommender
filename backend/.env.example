# Copy this file to .env and fill in your own API keys.
# All of these are FREE to get with a personal account.

# Movies & Series — https://www.themoviedb.org/settings/api
TMDB_API_KEY=[REDACTED]

# Anime & Manga — Jikan (MyAnimeList) needs NO key at all: https://jikan.moe/
# (nothing to fill here — kept for reference only)

# Games — https://rawg.io/apidocs
RAWG_API_KEY=[REDACTED]

# Novels — Google Books needs NO key for basic search, but you can add one
# for higher rate limits: https://console.cloud.google.com/apis/credentials
GOOGLE_BOOKS_API_KEY=

# Comics — https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=[REDACTED]

# Music — https://developer.spotify.com/dashboard (create an app)
SPOTIFY_CLIENT_ID=[REDACTED]
SPOTIFY_CLIENT_SECRET=[REDACTED]
